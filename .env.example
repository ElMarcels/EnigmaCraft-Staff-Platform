# Base de datos PostgreSQL (Vercel Postgres, Neon, Supabase, etc.).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Token de lectura/escritura de Vercel Blob.
# https://vercel.com/docs/storage/vercel-blob/using-blob-sdk#generate-a-read-write-token
BLOB_READ_WRITE_TOKEN=""

# Fundador inicial de la plataforma (bootstrap). El seed crea este usuario si no existe.
# Copia este archivo a .env y rellena con las credenciales del fundador.
FOUNDER_USERNAME=""
FOUNDER_PASSWORD=""
FOUNDER_DISPLAY_NAME=""

# Secreto para firmar las cookies de sesión (SESSION_SECRET). Genera uno nuevo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Secreto compartido para proteger el cron de copias de seguridad (debe coincidir en Vercel).
CRON_SECRET=""